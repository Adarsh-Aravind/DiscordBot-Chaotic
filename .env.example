# Copy this file to `.env` and fill in what you need:
#   cp .env.example .env
#
# Only DISCORD_TOKEN is truly required. Everything else is optional — leaving a
# value blank falls back to the default baked into utils/config.js, shown in the
# comment above each one.
#
# Because blank means "use the default", blanking a setting cannot switch a
# feature off. The YOUTUBE_ENABLED / TWITCH_ENABLED flags below exist for that.


# =============================================================================
# REQUIRED
# =============================================================================

# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your_bot_token_here


# =============================================================================
# RIRI — AI chat (mention the bot at the start of a message to talk to her)
# =============================================================================

# Groq API key. Without this, mentioning the bot does nothing.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# default: qwen/qwen3.8-27b (llama-3.3-70b-versatile was retired by Groq)
GROQ_MODEL=

# Messages of context riri remembers per person, per channel. default: 8
AI_MEMORY_TURNS=

# Max tokens per reply — replies are meant to be 1-2 lines. default: 120
AI_MAX_TOKENS=

# Request timeout in milliseconds. default: 20000
AI_TIMEOUT_MS=

# Riri butting into conversations nobody invited her to.
# Set to false to keep her quiet unless mentioned or replied to. default: true
AI_INTERJECT_ENABLED=

# Chance rolled per eligible message. 0 disables it. default: 0.0125 (~1 in 80)
AI_INTERJECT_CHANCE=

# Minimum gap between interjections in one channel, ms. default: 300000 (5 min)
AI_INTERJECT_COOLDOWN_MS=

# Riri is written as this person's girlfriend — warm with him, uninterested in
# everyone else. default: 753892329982787624
AI_PARTNER_USER_ID=

# Where she posts when he goes quiet. default: 1322260150761033739
AI_HOME_CHANNEL_ID=


# =============================================================================
# RIRI SULKING
# =============================================================================
# If the partner hasn't said anything anywhere in the server for a while, she
# posts in the home channel. Escalates at 2x and 4x the threshold.

# default: true
CLINGY_ENABLED=

# Silence before she says something, in ms. default: 10800000 (3 hours)
CLINGY_SILENCE_MS=

# Minimum gap between her messages, in ms. However long the silence runs, she
# only says it once per window. default: 10800000 (3 hours)
CLINGY_COOLDOWN_MS=

# How often to check, in ms. default: 600000 (10 min)
CLINGY_CHECK_INTERVAL_MS=

# Ping him, or just post in the channel. default: true
CLINGY_MENTION=


# =============================================================================
# SERVER IDS — change these to point the bot at a different server
# =============================================================================

# Roles allowed to use restricted (🔒) commands — any one of them is enough.
# Comma-separated. Setting this replaces the whole list.
# default: 1322261748895711353,1482112143758458953
ALLOWED_ROLE_IDS=

# The original single-role setting. Still honoured: whatever you put here is
# added alongside the full-access staff role 1482112143758458953. Ignored if
# ALLOWED_ROLE_IDS is set. default: 1322261748895711353
ALLOWED_ROLE_ID=

# User who always has access, regardless of roles. default: 1135904133145178242
ALLOWED_USER_ID=

# Bot owner — receives forwarded DMs, and can use `.reply <user_id> <message>`
# default: unset (DM forwarding is off until you set this)
OWNER_ID=

# Channel that `.hof` posts into. default: 1488848396298096692
HOF_CHANNEL_ID=

# Passive reaction: this user's messages get reacted to. default: 753892329982787624
REACTION_USER_ID=


# =============================================================================
# BEHAVIOUR
# =============================================================================

# Command prefix. default: .
PREFIX=

# How often `.drag` yanks someone to a new channel, in ms. default: 2500
DRAG_INTERVAL_MS=

# Auto-AFK: this user gets moved to the AFK channel after sitting deafened for
# a while. Covers self-deafen and a moderator's server-deafen.
# Set to false to turn it off. default: true
AFK_ENABLED=

# Who gets parked. default: 623754619784527888
AFK_USER_ID=

# Where they get parked — must be a voice channel. default: 1322265047220617270
AFK_CHANNEL_ID=

# How long they must stay deafened first, in ms. default: 60000 (1 min)
AFK_DEAFEN_GRACE_MS=


# =============================================================================
# YOUTUBE UPLOAD NOTIFICATIONS
# =============================================================================

# Set to false to turn the watcher off. Blanking the two settings below will
# NOT do it — they fall back to the baked-in defaults. These announcements ping
# @everyone, so this is the switch you want. default: true
YOUTUBE_ENABLED=

# Comma-separated channel IDs to watch.
# default: the five channel IDs listed in utils/config.js
YOUTUBE_CHANNEL_IDS=

# Discord channel that upload announcements post to. default: 1162427835059806299
YOUTUBE_ANNOUNCE_CHANNEL_ID=

# How often to poll the RSS feeds, in ms. default: 300000 (5 min)
YOUTUBE_POLL_INTERVAL_MS=


# =============================================================================
# TWITCH GO-LIVE NOTIFICATIONS
# =============================================================================
# Unlike YouTube there's no public feed, so these two are required or the
# watcher stays off. Register an app at https://dev.twitch.tv/console/apps
# (any name, OAuth redirect http://localhost, category "Chat Bot") and copy
# the Client ID and a generated Client Secret here.

# Set to false to turn the watcher off without clearing the credentials.
# These announcements ping @everyone too. default: true
TWITCH_ENABLED=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch logins (the name in the URL, not the display name).
# default: r0gue___,srgamerog
TWITCH_LOGINS=

# Discord channel that go-live announcements post to. default: 1162427835059806299
TWITCH_ANNOUNCE_CHANNEL_ID=

# How often to poll, in ms. default: 120000 (2 min)
TWITCH_POLL_INTERVAL_MS=

# Flag a streamer's server nickname with a red dot while they are live.
# There is no way to map a Twitch login to a Discord user automatically, so
# this stays inert until you fill it in. Format: login:userId,login:userId
# e.g. r0gue___:123456789012345678,srgamerog:987654321098765432
TWITCH_LIVE_NICKNAME_MAP=

# default: true — but does nothing while the map above is empty.
TWITCH_LIVE_NICKNAME_ENABLED=


# =============================================================================
# DEAFEN SHAME BOARD
# =============================================================================
# Tracks how long everyone sits deafened in voice and posts a periodic ranking.
# `.shame` shows the current board, `.shame all` shows all-time.

# default: true
DEAFEN_BOARD_ENABLED=

# Where the ranking posts. default: 1162427835059806299
DEAFEN_BOARD_CHANNEL_ID=

# How often a ranking goes out, in ms. default: 604800000 (7 days)
DEAFEN_BOARD_INTERVAL_MS=

# How often to check whether one is due, in ms. default: 3600000 (1 hour)
DEAFEN_BOARD_CHECK_INTERVAL_MS=

# How many people the ranking lists. default: 10
DEAFEN_BOARD_TOP_N=

# Stints below this are a fumbled hotkey, not an insult, in ms. default: 30000
DEAFEN_BOARD_MIN_SESSION_MS=
